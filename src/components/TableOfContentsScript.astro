<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const sectionIds = new Map();
    document.querySelectorAll("section").forEach((section) => {
      const id =
        section.id ||
        section.querySelector(":scope > :is(h1, h2, h3, h4, h5, h6)[id]")?.id;
      if (id) sectionIds.set(section, id);
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const id = sectionIds.get(entry.target);
        const headers = document.querySelectorAll(`.track a[href="#${id}"]`);
        headers.forEach((header) => {
          if (entry.intersectionRatio > 0) {
            header.classList.remove("text-muted-foreground");
          } else {
            header.classList.add("text-muted-foreground");
          }
        });
      });
    });

    sectionIds.forEach((_, section) => observer.observe(section));
  });
</script>
