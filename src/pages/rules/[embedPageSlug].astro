---
import RuleEmbedPage from "@/components/markdown/RuleEmbedPage.astro";
import { EntryTypeList } from "@/utils/entryTypes";

export async function getStaticPaths() {
  return EntryTypeList.map((type) => ({
    params: {
      embedPageSlug: type.toLowerCase(),
    },
    props: {
      type,
    },
  }));
}

const { type } = Astro.props;
---

<RuleEmbedPage entryType={type} fields={["entry_status"]} />
